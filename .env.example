PORT=3000
NODE_ENV=development

# Required in production: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Leave empty for local, in-memory accounts and short links (lost on restart).
# Set a real MongoDB URI for persistence. A configured but unavailable DB fails closed.
MONGODB_URI=

# Set this to the public HTTPS origin when deployed behind a reverse proxy.
PUBLIC_BASE_URL=
TRUST_PROXY=0
COOKIE_SECURE=false

# Optional: absolute FFmpeg executable path. Docker uses /usr/bin/ffmpeg.
FFMPEG_PATH=

# Optional: absolute path to soffice.exe/libreoffice for full document conversion.
# Standard installation paths are detected automatically. Docker sets this path.
LIBREOFFICE_PATH=
